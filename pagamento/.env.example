# Copie para .env.local (teste no computador) ou cadastre na Vercel (Settings → Environment Variables).
# NUNCA coloque valores reais neste arquivo nem no git.

# --- Mercado Pago (app VLC-F4LET → Credenciais) ---
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=
# Assinatura secreta do webhook (Suas integrações → Webhooks → depois de salvar a URL)
MP_WEBHOOK_SECRET=

# --- Stays (API Externa; credenciais pedidas ao suporte da Stays) ---
STAYS_BASE_URL=https://fletho.stays.net
STAYS_CLIENT_ID=
STAYS_CLIENT_SECRET=
# Opcional: ID do provedor de pagamento na Stays (GET /external/v1/finance/payment-providers)
STAYS_PAYMENT_PROVIDER_ID=

# --- Página ---
PUBLIC_BASE_URL=https://pagamento.f4let.com
SITE_URL=https://www.f4let.com
MAX_INSTALLMENTS=3
PIX_EXPIRATION_MINUTES=30
STATEMENT_DESCRIPTOR=4LETHOMES

# 1 = usa reservas falsas (TESTE1 a pagar, TESTE2 já paga) para testar sem a Stays
MOCK_STAYS=0
